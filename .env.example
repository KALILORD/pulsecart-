# ── AI copy generation (pick one, all optional) ──────────────────────────────
# Without a key the pipeline uses its deterministic template writer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Social publishing (optional) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE=
MASTODON_TOKEN=

# ── Trend sources (optional) ─────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:pulsecart:v0.1 (by /u/pulsecart)

# ── Currency override (optional) ─────────────────────────────────────────────
# Used only if the marketplace returns USD and no live FX quote is available.
USD_ZAR_RATE=

# ── Cloudflare Pages (optional GitHub Actions deploy hook) ───────────────────
# Leave empty when Cloudflare Pages is connected directly to the repository.
CLOUDFLARE_DEPLOY_HOOK=
